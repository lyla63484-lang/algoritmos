programa {
  funcao inicio() {
     
    inteiro notas[5]
    real alturas[10]
    cadeia nomes[3]
    logico respostas[4]

    // Cadeia
    nomes[0] = "Ana"
    nomes[1] = "Bruno"
    nomes[2] = "Carla"

    // Real
    alturas[0] = 1.65
    alturas[1] = 1.72
    alturas[2] = 1.58

    // Lógico
    respostas[0] = verdadeiro
    respostas[1] = falso

    // Mostrando os valores
    escreva("Nome: ", nomes[0], "\n")
    escreva("Altura: ", alturas[0], "\n")
    escreva("Resposta: ", respostas[0], "\n")
  }
}