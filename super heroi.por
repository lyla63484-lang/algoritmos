programa {
  funcao inicio() {
    cadeia nome
    inteiro nivelPoder
    real velocidadeMaxima
    logico habilidadededeVoo

    nome = "Mulher Gato"
    nivelPoder = 95
    velocidadeMaxima = 1200.0
    habilidadeVoo = verdadeiro

    escreva("Nome: " , nome, "\n")
    escreva("Nivel de Poder: ", nivelPoder, "\n")
    escreva("Velocidade Maxima: ", velocidadeMaxima, "\n")
    escreva("Habilidade Voo: ", habilidadeVoo)
  }
}
