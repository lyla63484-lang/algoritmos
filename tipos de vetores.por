programa {
  funcao inicio() {
     
    inteiro notas[5]
    real alturas[10]
    cadeia nomes[3]
    logico respostas[4]

    // Cadeia
    nomes[0] = "Ana"
    nomes[1] = "Bruno"
    nomes[2] = "Carla"

    // Real
    alturas[0] = 1.65
    alturas[1] = 1.72
    alturas[2] = 1.58
    alturas[3] = 1.33
    alturas[4] = 1.50
    alturas[5] = 2.05
    alturas[6] = 1.24
    alturas[7] = 1.77
    alturas[8] = 1.90
    alturas[9] = 2.01

    // Lógico
    respostas[0] = verdadeiro
    respostas[1] = falso
    respostas[2] = verdadeiro
    respostas[3] = falso

    //inteiro
    notas[0] = 8
    notas[1] = 9
    notas[2] = 10
    notas[3] = 7
    notas[4] = 6

    // Mostrando os valores
    escreva("Nome: ", nomes[0], "\n")
    nomes[0] = "Ana"
    nomes[1] = "Bruno"
    nomes[2] = "Carla"


    escreva("Altura: ", alturas[0], "\n")
    alturas[0] = 1.65
    alturas[1] = 1.72
    alturas[2] = 1.58
    alturas[3] = 1.33
    alturas[4] = 1.50
    alturas[5] = 2.05
    alturas[6] = 1.24
    alturas[7] = 1.77
    alturas[8] = 1.90
    alturas[9] = 2.01


    escreva("Resposta: ", respostas[0], "\n")
    respostas[0] = verdadeiro
    respostas[1] = falso
    respostas[2] = verdadeiro
    respostas[3] = falso


    escreva("Nota: ", notas[0], "\n")
    notas[0] = 8
    notas[1] = 9
    notas[2] = 10
    notas[3] = 7
    notas[4] = 6


  }
}
